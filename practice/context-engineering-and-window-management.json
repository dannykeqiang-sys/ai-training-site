7edf\u6307\u4ee4\u3001\u7528\u6237\u8f93\u5165\u3001\u68c0\u7d22\u77e5\u8bc6\u3001\u5386\u53f2\u5bf9\u8bdd\u3001\u5de5\u5177\u5b9a\u4e49\u3001\u6301\u4e45\u5316\u89c4\u5219\u7b49\uff0c\u65f6\u95f4\u8de8\u5ea6\u8986\u76d6\u591a\u8f6e\u5bf9\u8bdd\u3001\u8de8\u4f1a\u8bdd\u3001\u6574\u4e2a Agent \u751f\u547d\u5468\u671f\u3002\u6559\u7a0b\u660e\u786e\u6307\u51fa\uff1aPrompt Engineering \u662f Context Engineering \u7684**\u5b50\u96c6**\u2014\u2014\u524d\u8005\u53ea\u7ba1\"\u600e\u4e48\u8bf4\"\uff0c\u540e\u8005\u7ba1\"\u8bf4\u4ec0\u4e48\u3001\u4ec0\u4e48\u65f6\u5019\u8bf4\u3001\u5728\u54ea\u91cc\u8bf4\u3001\u8bf4\u591a\u5c11\"\u3002\u56e0\u6b64 D \u9009\u9879\u628a\u5305\u542b\u5173\u7cfb\u8bf4\u53cd\u4e86\uff0cC \u9009\u9879\u628a\u9002\u7528\u573a\u666f\u8bf4\u53cd\u4e86\uff0cA \u9009\u9879\u5ffd\u7565\u4e86\u4e8c\u8005\u5728\u8303\u56f4\u548c\u6df1\u5ea6\u4e0a\u7684\u672c\u8d28\u5dee\u5f02\u3002"},{"id":"Q-context-engineering-and-window-management-4a820ee0","module":"context-engineering-and-window-management","moduleName":"\u4e0a\u4e0b\u6587\u5de5\u7a0b\u4e0e\u7a97\u53e3\u7ba1\u7406","difficulty":"medium","difficultyLabel":"\u4e2d\u7b49","isMultiSelect":false,"title":"\u4e0d\u540c AI \u7f16\u7801\u5de5\u5177\u7684\u4e0a\u4e0b\u6587\u7ba1\u7406\u7b56\u7565\u5bf9\u6bd4","stem":"\u6839\u636e\u6559\u7a0b\uff0c\u5173\u4e8e Claude Code\u3001Cursor\u3001Cline \u4e09\u6b3e AI \u7f16\u7801\u5de5\u5177\u7684\u4e0a\u4e0b\u6587\u7ba1\u7406\u7b56\u7565\uff0c\u4ee5\u4e0b\u54ea\u9879\u63cf\u8ff0\u662f**\u6b63\u786e**\u7684\uff1f","options":[{"key":"A","text":"Cursor \u901a\u8fc7 @\u6587\u4ef6\u540d\u3001@\u4ee3\u7801\u7b26\u53f7 \u8ba9\u7528\u6237\u663e\u5f0f\u5f15\u7528\u4e0a\u4e0b\u6587\uff0c\u9002\u5408\u9700\u8981\u7cbe\u786e\u63a7\u5236\u6ce8\u5165\u5185\u5bb9\u7684\u573a\u666f"},{"key":"B","text":"Claude Code \u9700\u8981\u7528\u6237\u901a\u8fc7 @\u5f15\u7528 \u624b\u52a8\u6307\u5b9a\u6bcf\u4e2a\u9700\u8981\u52a0\u8f7d\u7684\u6587\u4ef6\uff0c\u4e0d\u9002\u5408\"\u5f00\u7bb1\u5373\u7528\"\u7684\u4f7f\u7528\u65b9\u5f0f"},{"key":"C","text":"\u4e09\u6b3e\u5de5\u5177\u4e2d Cline \u7684 Token \u6548\u7387\u6700\u9ad8\uff0c\u56e0\u4e3a Agent \u81ea\u4e3b\u63a2\u7d22\u80fd\u6700\u7cbe\u51c6\u5730\u7b5b\u9009\u51fa\u76f8\u5173\u4ee3\u7801"},{"key":"D","text":"\u4e09\u6b3e\u5de5\u5177\u7684\u4e0a\u4e0b\u6587\u7ba1\u7406\u7b56\u7565\u5b8c\u5168\u76f8\u540c\uff0c\u533a\u522b\u4ec5\u5728\u4e8e\u652f\u6301\u4e0d\u540c\u7f16\u7a0b\u8bed\u8a00\u7684\u8bed\u6cd5\u89e3\u6790\u80fd\u529b"}],"answer":["A"],"explanation":"\u6559\u7a0b\u660e\u786e\u533a\u5206\u4e86\u4e09\u6b3e\u5de5\u5177\u7684\u6838\u5fc3\u7406\u5ff5\uff1aClaude Code \u91c7\u7528\"\u81ea\u52a8\u68c0\u7d22 + \u6e10\u8fdb\u52a0\u8f7d\"\uff0c\u81ea\u52a8\u68c0\u6d4b\u76f8\u5173\u6587\u4ef6\uff0c\u65e0\u9700\u624b\u52a8\u6307\u5b9a\uff0c\u9002\u5408\u901a\u7528\u5f00\u53d1\u3001\"\u5f00\u7bb1\u5373\u7528\"\uff0cToken \u6548\u7387\u9ad8\uff1bCursor \u91c7\u7528\"\u7528\u6237\u4e3b\u52a8\u63a7\u5236 + @ \u5f15\u7528\"\uff0c\u901a\u8fc7 @\u6587\u4ef6\u540d\u3001@\u4ee3\u7801\u7b26\u53f7 \u663e\u5f0f\u5f15\u7528\uff0c\u9002\u5408\u7cbe\u786e\u63a7\u5236\u573a\u666f\uff0cToken \u6548\u7387\u540c\u6837\u9ad8\uff1bCline \u91c7\u7528\"Agent \u81ea\u4e3b\u63a2\u7d22\"\uff0cAgent \u81ea\u4e3b\u4f7f\u7528 read_file/list_files/search_files \u5de5\u5177\uff0c\u9002\u5408\u63a2\u7d22\u6027\u4efb\u52a1\uff0c\u4f46 Token \u6548\u7387\u4e2d\u7b49\uff08\u53ef\u80fd\u8fc7\u5ea6\u63a2\u7d22\uff09\u3002B \u9009\u9879\u628a Claude Code \u7684\u7279\u70b9\u8bf4\u53cd\u4e86\uff1bC \u9009\u9879\u628a Cline \u7684 Token \u6548\u7387\u8bf4\u9519\u4e86\uff08\u4e2d\u7b49\u800c\u975e\u6700\u9ad8\uff09\uff1bD \u9009\u9879\u5b8c\u5168\u5ffd\u7565\u4e86\u4e09\u8005\u5728\u4e0a\u4e0b\u6587\u7ba1\u7406\u7b56\u7565\u4e0a\u7684\u672c\u8d28\u5dee\u5f02\u3002"},{"id":"Q-context-engineering-and-window-management-78004a77","module":"context-engineering-and-window-management","moduleName":"\u4e0a\u4e0b\u6587\u5de5\u7a0b\u4e0e\u7a97\u53e3\