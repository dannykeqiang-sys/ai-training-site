4ee4\u767d\u540d\u5355\uff08\u6309\u98ce\u9669\u7b49\u7ea7\u5206\u7ea7\uff09\u3001\u5206\u7ea7\u786e\u8ba4\uff08\u4f4e\u98ce\u9669\u81ea\u52a8\u6267\u884c\uff0c\u9ad8\u98ce\u9669\u9010\u4e2a\u786e\u8ba4\uff09\u3002"},{"id":"Q-agent-cli-extension-a7ecf986","module":"agent-cli-extension","moduleName":"Agent CLI \u547d\u4ee4\u6269\u5c55","difficulty":"medium","difficultyLabel":"\u4e2d\u7b49","isMultiSelect":false,"title":"\u4ece CLI \u5230 MCP \u7684\u8fc1\u79fb\u8def\u5f84","stem":"\u4ee5\u4e0b\u54ea\u4e2a\u4fe1\u53f7\u8868\u660e\u5e94\u8be5\u4ece CLI \u547d\u4ee4\u8c03\u7528\u8fc1\u79fb\u5230 MCP \u96c6\u6210\uff1f","options":[{"key":"A","text":"\u67d0\u4e2a CLI \u547d\u4ee4\u6bcf\u5468\u88ab\u6267\u884c\u8d85\u8fc7 100 \u6b21\uff0c\u4e14\u8f93\u51fa\u683c\u5f0f\u53d8\u5316\u5bfc\u81f4\u8fc7 Agent \u51fa\u9519"},{"key":"B","text":"Agent \u53ea\u4f7f\u7528\u4e86\u4e00\u6b21\u67d0\u4e2a CLI \u547d\u4ee4\u6765\u63a2\u7d22\u65b0\u529f\u80fd"},{"key":"C","text":"\u56e2\u961f\u53ea\u6709\u4e00\u4e2a\u4eba\u4f7f\u7528 Agent\uff0c\u4e0d\u9700\u8981\u6807\u51c6\u5316"},{"key":"D","text":"CLI \u547d\u4ee4\u7684\u6267\u884c\u901f\u5ea6\u5df2\u7ecf\u8db3\u591f\u5feb\uff0c\u6ca1\u6709\u4efb\u4f55\u6027\u80fd\u95ee\u9898"}],"answer":["A"],"explanation":"\u4ece CLI \u5230 MCP \u7684\u8fc1\u79fb\u4fe1\u53f7\u5305\u62ec\uff1a1\uff09\u9ad8\u9891\u8c03\u7528\u2014\u2014\u67d0\u4e2a CLI \u547d\u4ee4\u88ab Agent \u9891\u7e41\u8c03\u7528\uff08\u5982\u6bcf\u5929\u6570\u767e\u6b21 curl \u8c03\u7528\u67d0\u4e2a API\uff09\uff1b2\uff09\u7a33\u5b9a\u6027\u8981\u6c42\u9ad8\u2014\u2014CLI \u547d\u4ee4\u7684\u8f93\u51fa\u683c\u5f0f\u53d8\u5316\u5bfc\u81f4 Agent \u89e3\u6790\u5931\u8d25\uff1b3\uff09\u56e2\u961f\u534f\u4f5c\u9700\u6c42\u2014\u2014\u591a\u4eba\u4f7f\u7528\u540c\u4e00\u5957 CLI \u547d\u4ee4\uff0c\u9700\u8981\u6807\u51c6\u5316\u548c\u7248\u672c\u7ba1\u7406\uff1b4\uff09\u5b89\u5168\u5408\u89c4\u8981\u6c42\u2014\u2014\u9700\u8981\u5bf9\u5de5\u5177\u8c03\u7528\u8fdb\u884c\u7ec6\u7c92\u5ea